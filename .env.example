NODE_ENV=development

# Infrastructure
POSTGRES_PORT=5432
REDIS_PORT=6379
DASHBOARD_PORT=3001
# Origin used by the browser and allowed by the local API. Keep this in sync
# with DASHBOARD_PORT, or set it to a custom local dashboard URL.
DASHBOARD_ORIGIN=http://localhost:3001
DATABASE_URL=postgresql://notification:notification@localhost:5432/notification_platform?schema=public
REDIS_URL=redis://localhost:6379
# Periodically retries committed jobs that could not be submitted to Redis.
OUTBOX_FLUSH_INTERVAL_MS=5000

# API security
API_PORT=3000
DASHBOARD_URL=http://localhost:3001
# Browser requests stay same-origin and are forwarded by the dashboard's
# server-side proxy. Keep this relative path in local and production builds.
NEXT_PUBLIC_API_URL=/api/proxy
# API address reachable from the dashboard server. Docker Compose overrides
# this with http://api:3000; npm run dev uses the local default below.
API_INTERNAL_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
# Short expiry for browser-held in-app inbox tokens minted by a tenant's
# backend via POST /v1/users/:externalUserId/token.
USER_TOKEN_EXPIRES_IN=1h
API_KEY_PEPPER=replace-with-a-separate-long-random-secret
CORS_ORIGINS=http://localhost:3001

# Delivery defaults: `console` is safe for local development and tests.
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@example.test

# Resend SMTP aliases. When set, these take priority over SMTP_PASSWORD and
# SMTP_FROM. Use the API key as the SMTP password and a verified sender address.
RESEND_API_KEY=
EMAIL_FROM=

# Firebase Cloud Messaging (only required when PUSH_PROVIDER=fcm)
PUSH_PROVIDER=console
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Outbound client webhooks
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
# 32-byte base64 key used to encrypt webhook signing secrets at rest.
WEBHOOK_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
