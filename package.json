{
  "name": "universal-notification-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant notification infrastructure platform",
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,dashboard,workers -c blue,magenta,green \"npm run dev -w @notification-platform/api\" \"npm run dev -w @notification-platform/dashboard\" \"npm run dev -w @notification-platform/workers\"",
    "dev:api": "npm run dev -w @notification-platform/api",
    "dev:dashboard": "npm run dev -w @notification-platform/dashboard",
    "dev:workers": "npm run dev -w @notification-platform/workers",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @notification-platform/api",
    "lint": "npm run lint --workspaces --if-present",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "node --env-file-if-exists=.env --import tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
