# Copy to .env.production; never commit the resulting file.
NODE_ENV=production

# Use managed services that are reachable from this host/container network.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?schema=public
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379
OUTBOX_FLUSH_INTERVAL_MS=5000

# Generate unique values in your secret manager. Do not reuse local secrets.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=15m
API_KEY_PEPPER=replace-with-a-separate-random-secret-of-at-least-24-characters
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Public browser-to-API contract. Use exact HTTPS origins, never '*'.
DASHBOARD_URL=https://dashboard.example.com
CORS_ORIGINS=https://dashboard.example.com
# Keep browser calls same-origin; the dashboard server proxies to the API
# service over the private Compose network.
NEXT_PUBLIC_API_URL=/api/proxy
API_INTERNAL_URL=http://api:3000

# Host loopback ports for a reverse proxy running on the same machine.
API_BIND_PORT=3000
DASHBOARD_BIND_PORT=3001

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=notifications@example.com

PUSH_PROVIDER=console
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
