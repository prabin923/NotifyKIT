generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum DashboardRole {
  OWNER
  ADMIN
  DEVELOPER
  ANALYST
  VIEWER
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum EventStatus {
  ACCEPTED
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationStatus {
  CREATED
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  OPENED
  FAILED
  RETRYING
  CANCELLED
  EXPIRED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum Channel {
  EMAIL
  PUSH
  WEBHOOK
}

enum DeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  RETRYING
  CANCELLED
  DEAD_LETTER
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  DISABLED
}

enum WebhookStatus {
  ACTIVE
  DISABLED
}

enum DevicePlatform {
  ANDROID
  WEB
  IOS
}

model Tenant {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  plan            TenantPlan      @default(FREE)
  status          TenantStatus    @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  users           User[]
  dashboardUsers  DashboardUser[]
  apiKeys         ApiKey[]
  devices         Device[]
  events          Event[]
  notifications   Notification[]
  deliveries      Delivery[]
  templates       Template[]
  preferences     NotificationPreference[]
  workflows       Workflow[]
  webhooks        Webhook[]
  webhookDeliveries WebhookDelivery[]
  auditLogs       AuditLog[]
  outboxJobs      OutboxJob[]
  tenantPolicy    TenantPolicy?

  @@map("tenants")
}

model DashboardUser {
  id           String        @id @default(cuid())
  tenantId     String        @map("tenant_id")
  email        String        @unique
  name         String
  passwordHash String        @map("password_hash")
  role         DashboardRole @default(VIEWER)
  status       UserStatus    @default(ACTIVE)
  lastLoginAt  DateTime?     @map("last_login_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  auditLogs    AuditLog[]

  @@index([tenantId, role])
  @@map("dashboard_users")
}

model User {
  id         String     @id @default(cuid())
  tenantId   String     @map("tenant_id")
  externalId String     @map("external_id")
  name       String?
  email      String?
  phone      String?
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices    Device[]
  preferences NotificationPreference[]
  notifications Notification[]

  @@unique([tenantId, externalId])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@map("users")
}

model ApiKey {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  name        String
  keyHash     String       @unique @map("key_hash")
  prefix      String
  permissions String[]
  status      ApiKeyStatus @default(ACTIVE)
  expiresAt   DateTime?    @map("expires_at")
  lastUsedAt  DateTime?    @map("last_used_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, prefix])
  @@map("api_keys")
}

model Device {
  id           String         @id @default(cuid())
  tenantId     String         @map("tenant_id")
  userId       String         @map("user_id")
  deviceToken  String         @unique @map("device_token")
  platform     DevicePlatform
  appVersion   String?        @map("app_version")
  lastActiveAt DateTime?      @map("last_active_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("devices")
}

model Event {
  id             String      @id @default(cuid())
  tenantId       String      @map("tenant_id")
  eventType      String      @map("event_type")
  externalEventId String?    @map("external_event_id")
  idempotencyKey String?     @map("idempotency_key")
  payload        Json
  status         EventStatus @default(ACCEPTED)
  createdAt      DateTime    @default(now()) @map("created_at")
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, externalEventId])
  @@index([tenantId, eventType, createdAt])
  @@index([tenantId, status, createdAt])
  @@map("events")
}

model Notification {
  id          String             @id @default(cuid())
  tenantId    String             @map("tenant_id")
  userId      String             @map("user_id")
  eventId     String?            @map("event_id")
  templateId  String?            @map("template_id")
  title       String
  subject     String?
  body        String
  priority    Priority           @default(NORMAL)
  category    String             @default("transactional")
  status      NotificationStatus @default(CREATED)
  scheduledAt DateTime?          @map("scheduled_at")
  expiresAt   DateTime?          @map("expires_at")
  cancelledAt DateTime?          @map("cancelled_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: SetNull)
  template    Template?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  deliveries  Delivery[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, scheduledAt])
  @@map("notifications")
}

model Delivery {
  id                String         @id @default(cuid())
  tenantId          String         @map("tenant_id")
  notificationId    String         @map("notification_id")
  channel           Channel
  provider          String
  status            DeliveryStatus @default(QUEUED)
  attempts          Int            @default(0)
  providerMessageId String?        @map("provider_message_id")
  sentAt            DateTime?      @map("sent_at")
  deliveredAt       DateTime?      @map("delivered_at")
  failedAt          DateTime?      @map("failed_at")
  errorCode         String?        @map("error_code")
  errorMessage      String?        @map("error_message")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notification      Notification   @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, channel, status])
  @@map("deliveries")
}

model Template {
  id        String         @id @default(cuid())
  tenantId  String         @map("tenant_id")
  name      String
  eventType String         @map("event_type")
  channel   Channel
  subject   String?
  body      String
  language  String         @default("en")
  version   Int            @default(1)
  status    TemplateStatus @default(DRAFT)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([tenantId, eventType, channel, language, version])
  @@index([tenantId, eventType, channel, status])
  @@map("templates")
}

model NotificationPreference {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  category  String
  channel   Channel
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category, channel])
  @@index([tenantId, userId, category])
  @@map("notification_preferences")
}

model Workflow {
  id         String         @id @default(cuid())
  tenantId   String         @map("tenant_id")
  name       String
  eventType  String         @map("event_type")
  status     WorkflowStatus @default(DRAFT)
  definition Json
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, status])
  @@map("workflows")
}

model Webhook {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  url       String
  secret    String
  events    String[]
  status    WebhookStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhooks")
}

model WebhookDelivery {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  webhookId      String         @map("webhook_id")
  notificationId String?        @map("notification_id")
  event          String
  dedupeKey      String         @unique @map("dedupe_key")
  payload        Json
  status         DeliveryStatus @default(QUEUED)
  attempts       Int            @default(0)
  sentAt         DateTime?      @map("sent_at")
  failedAt       DateTime?      @map("failed_at")
  errorCode      String?        @map("error_code")
  errorMessage   String?        @map("error_message")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhook        Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

model TenantPolicy {
  id                         String   @id @default(cuid())
  tenantId                   String   @unique @map("tenant_id")
  mandatorySecurityChannels  Channel[] @default([]) @map("mandatory_security_channels")
  requestsPerMinute          Int      @default(100) @map("requests_per_minute")
  notificationsPerHour       Int      @default(10000) @map("notifications_per_hour")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_policies")
}

model AuditLog {
  id              String         @id @default(cuid())
  tenantId        String         @map("tenant_id")
  actorUserId     String?        @map("actor_user_id")
  action          String
  resource        String
  resourceId      String?        @map("resource_id")
  metadata        Json?
  ipAddress       String?        @map("ip_address")
  createdAt       DateTime       @default(now()) @map("created_at")
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor           DashboardUser? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, resource, resourceId])
  @@map("audit_logs")
}

/// Transactional outbox: rows are committed alongside notification records and
/// only marked processed after BullMQ has accepted the matching idempotent job.
model OutboxJob {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  queue       String
  jobName     String   @map("job_name")
  dedupeKey   String   @unique @map("dedupe_key")
  payload     Json
  availableAt DateTime @default(now()) @map("available_at")
  processedAt DateTime? @map("processed_at")
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([processedAt, availableAt])
  @@index([tenantId, createdAt])
  @@map("outbox_jobs")
}
