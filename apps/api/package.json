{
  "name": "@notification-platform/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently -k \"tsc --watch -p tsconfig.build.json\" \"node --env-file-if-exists=../../.env --watch dist/main.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "rm -rf dist && prisma generate --schema ../../prisma/schema.prisma && tsc -p tsconfig.build.json",
    "build:compute": "npm run build && node scripts/prepare-compute-artifact.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5"
  }
}
