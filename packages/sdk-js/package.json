{
  "name": "@notification-platform/sdk",
  "version": "0.1.0",
  "description": "JavaScript/TypeScript SDK for the NotifyKIT notification platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notification-platform/notification-system.git",
    "directory": "packages/sdk-js"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  }
}
